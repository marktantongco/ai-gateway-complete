{
  "manifest_version": 3,
  "name": "BlacklistedAIProxy Cookie Exporter",
  "version": "1.0.0",
  "description": "Export Grok/X session cookies for BlacklistedAIProxy",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://grok.com/*",
    "https://x.com/*",
    "https://www.x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Session Cookies"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
